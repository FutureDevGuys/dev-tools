[Unit]
Description=Dev Auth explicitly approved administrator grants
After=polkit.service systemd-logind.service
Requires=polkit.service

[Service]
Type=simple
ExitType=main
RemainAfterExit=no
User=root
Group=root
ExecStart=/usr/local/bin/dev-auth privilege-daemon --policy /etc/dev-auth/privilege-policy.json --runtime /run/dev-auth-privilege
RuntimeDirectory=dev-auth-privilege
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=5s
Restart=on-failure
RestartSec=2s
Delegate=no
TasksMax=4096
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
