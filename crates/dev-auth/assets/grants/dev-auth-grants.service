[Unit]
Description=Dev Auth explicitly approved administrator grants
After=polkit.service systemd-logind.service
Requires=polkit.service

[Service]
Type=simple
ExitType=main
RemainAfterExit=no
User=root
Group=root
ExecStart=/usr/local/bin/dev-auth grant-daemon --policy /etc/dev-auth/administrator-grants-v1.json --runtime /run/dev-auth-grants
RuntimeDirectory=dev-auth-grants
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
KillMode=mixed
SendSIGKILL=yes
TimeoutStopSec=90s
OOMPolicy=continue
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=2s
Delegate=no
TasksMax=4096
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
