# Common junk-only ignore baseline for sync-configs.
# Curated from typical gitignore-generator templates for cross-language repos.
# Intentionally excludes secret/env patterns such as `.env`, keys, and certs.

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/
._*

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/

# JavaScript / TypeScript
node_modules/
.npm/
.pnpm-store/
.yarn/
.turbo/
.eslintcache
.stylelintcache
.svelte-kit/
.parcel-cache/
.next/
.nuxt/
vite.svg
*.tsbuildinfo

# Rust
target/

# Go
.coverprofile
cover.out

# Java / JVM
.gradle/
*.class
*.jar
*.war
*.nar
hs_err_pid*
replay_pid*

# C / C++ / native toolchains
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
makedep*
libtool
aclocal.m4
m4/
autom4te.cache/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# .NET
obj/
*.rsuser

# Ruby
.bundle/

# Elixir / Erlang
_build/
erl_crash.dump

# Terraform / infra
.terraform/
.terragrunt-cache/
.serverless/
.aws-sam/

# Generic build/cache outputs
dist/
build/
out/
coverage/
.cache/
tmp/
tmp-*/
